# Production environment variables for docker-compose.prod.yaml
# Copy to .env and fill in values.

# Cloudflare Tunnel token (from Zero Trust dashboard -> Tunnels -> Configure)
TUNNEL_TOKEN=

# Relay server token for lens-editor auth proxy
RELAY_SERVER_TOKEN=

# Discord bot token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=

# Share token secret for lens-editor share links. The relay needs the same
# value (on prod via /root/auth.env): its /mcp endpoint accepts only share
# tokens signed with it, and is off when it is unset.
SHARE_TOKEN_SECRET=

# Jina Reader API key for the article importer's render tier (r.jina.ai).
# REQUIRED in production: without it Jina applies anonymous rate limits and
# queues/starves render requests, which stalls imports from bot-blocked sites.
JINA_API_KEY=
# Residential proxy for the YouTube caption-URL mint (one ~4KB request per
# video import). Without it, video imports fail from datacenter IPs --
# YouTube bot-checks them. Format: http://user:pass@host:port
YT_PROXY_URL=
# Claude Code auth for the transcript/QC formatter. Prefer a subscription
# OAuth token (no per-transcript cost): generate with `claude setup-token`.
# If set, leave ANTHROPIC_API_KEY empty (a non-empty key shadows this token).
CLAUDE_CODE_OAUTH_TOKEN=

# Datalab Marker API key — PDF parsing for the article importer (free monthly
# allowance covers our volume). With no key set, PDFs fall back to the local
# text extraction.
DATALAB_API_KEY=

# Lens Editor production-promotion feature.
# Leave disabled unless the rollout gates in docs/server-ops.md have been checked.
PROMOTION_ENABLED=false
PROMOTION_REPO_HOST_DIR=/root/lens-editor-promotion-data/repositories
PROMOTION_SSH_DIR=/root/lens-editor-promotion-data/ssh
PROMOTION_PRODUCTION_REPO_URL=git@github.com-lens-editor-promotion:Lens-Academy/lens-edu-production.git
PROMOTION_STAGING_REPO_URL=git@github.com-lens-editor-promotion:Lens-Academy/lens-edu-staging.git
PROMOTION_REPO_DIR=/data/lens-editor/promotion-repos/lens-edu-production
PROMOTION_MAIN_BRANCH=production
PROMOTION_STAGING_BRANCH=staging
PROMOTION_BRANCH_PREFIX=promote/lens-editor
PROMOTION_MERGE_METHOD=SQUASH
PROMOTION_GITHUB_OWNER=Lens-Academy
PROMOTION_GITHUB_REPO=lens-edu-production
GITHUB_TOKEN=

# Base URL of the Lens Editor. When set, the `get_url` MCP tool returns absolute
# links (e.g. https://editor.lensacademy.org/<prefix>/<path>); otherwise it
# returns the relative /<prefix>/<path> locator.
EDITOR_BASE_URL=https://editor.lensacademy.org

# relay-git-sync secrets (SSH keys are in /root/relay-git-sync-data/ssh/, not env vars)
RELAY_SERVER_API_KEY=
WEBHOOK_SECRET=

# Base URL the relay uses to reach the lens-editor importer for the MCP
# import_source/import_status/import_attachment tools. Default matches the
# docker-compose service address; for local dev outside Docker use
# http://localhost:3000.
# LENS_EDITOR_URL=http://lens-editor:3000

# Public raw base URL per relay folder, `Folder=https://base;Other=https://base2`.
# Read by both the relay (public_url in the MCP import_attachment reply) and
# lens-editor (image URLs the article importer writes). Unset = the built-in
# mapping below; add a pair for any other synced folder.
# ATTACHMENT_PUBLIC_URLS=Lens Edu=https://raw.githubusercontent.com/Lens-Academy/lens-edu-staging/staging

# Used by validate_content, the checks in MCP edit and create replies, the
# mandatory article-import review (/api/content/validate-article before and
# after LLM repairs) and the editor's content status panel.
LENS_PLATFORM_URL=https://staging.lensacademy.org
ADHOC_VALIDATION_SECRET=
# The editor's content status panel. Turn it on only when the platform at
# LENS_PLATFORM_URL serves /api/content/file-status.
CONTENT_STATUS_ENABLED=false

# Read-aloud in the editor (Speechify simba-3.2, the platform's TTS). Empty
# hides the Listen button. TTS_CHARS_PER_HOUR caps one share link (default 500000).
# Speechify rate-limits per key (~1 request/s), so a key of its own keeps
# editor listening from competing with the platform's learners.
SPEECHIFY_API_KEY=
TTS_CHARS_PER_HOUR=
# Course checks (the relay reads it; on prod via /root/auth.env): with this
# true and the secret set, every MCP edit/create of a Lens Edu .md file
# (articles excepted) also asks /api/content/course-checks, with a 5 s
# timeout. lens-platform has a switch of the same name. Off by default.
ENABLE_COURSE_CHECKS=false

# Optional override; the default is 25 minutes, counted from when a worker
# starts the job (time spent waiting in the queue does not count).
# ARTICLE_JOB_TIMEOUT_MS=1500000

# The article import queue: saved here so a restart or deploy loses nothing
# (docker creates the directory). Imports run ARTICLE_IMPORT_WORKERS at a time
# (default 3); keep CLAUDE_SESSION_POOL_SIZE (default 3) at least as large.
ARTICLE_IMPORT_QUEUE_HOST_DIR=/root/lens-editor-data/article-import-queue
# ARTICLE_IMPORT_WORKERS=3
# CLAUDE_SESSION_POOL_SIZE=3

# Persistent structured diagnostics for online article imports. Create the host
# directory before deploying; inability to write a report fails the import.
ARTICLE_REVIEW_REPORT_HOST_DIR=/root/lens-editor-data/article-review-reports
ARTICLE_REVIEW_REPORT_RETENTION_DAYS=90
ARTICLE_REVIEW_EVIDENCE_RETENTION_DAYS=30

# Source sync: keep Relay files as read-only copies of Google Docs
# (lens-editor/server/source-sync/). Off while SOURCE_SYNC_BINDINGS is empty.
# A JSON array, one entry per synced file; the target is overwritten whenever
# it differs from the Doc, and the editor warns on the file that it is synced.
# Keys: source (Docs link; ?tab=<id> required when the Doc has several tabs),
# target (inside an articles/ folder), author (list, required), and optional
# title, published (YYYY-MM-DD), sourceUrl. A bad entry is logged on every run
# and skipped; the others still sync.
# SOURCE_SYNC_BINDINGS='[{"source":"https://docs.google.com/document/d/<id>/edit?tab=t.0","target":"Lens Edu/articles/<folder>/<file>.md","author":["<name>"]}]'
# Minutes between runs, 1 to 1440 (default 10):
# SOURCE_SYNC_INTERVAL_MINUTES=10
# Service-account key (the key file's JSON, base64-encoded to keep it on one
# line) with the Google Docs API enabled. It reads docs shared "anyone with the
# link can view" or shared with its client_email.
# GOOGLE_SERVICE_ACCOUNT_JSON=
