  "swap": [
    { "name": "inline keeps its label", "text": "See [The paper](https://example.com/a).", "url": "https://example.com/a", "rel": "../articles/x", "title": "Title", "expected": "See [[../articles/x|The paper]]." },
    { "name": "bare takes the title", "text": "See https://example.com/a.", "url": "https://example.com/a", "rel": "../articles/x", "title": "Title", "expected": "See [[../articles/x|Title]]." },
    { "name": "autolink takes the title", "text": "<https://example.com/a>", "url": "https://example.com/a", "rel": "../articles/x", "title": "Title", "expected": "[[../articles/x|Title]]" },
    { "name": "empty label takes the title", "text": "[](https://example.com/a)", "url": "https://example.com/a", "rel": "../articles/x", "title": "Title", "expected": "[[../articles/x|Title]]" },
    { "name": "table uses an escaped separator", "text": "| [x](https://example.com/a) | b |", "url": "https://example.com/a", "rel": "../articles/x", "title": "Title", "expected": "| [[../articles/x\\|x]] | b |" },
    { "name": "title is cleaned", "text": "https://example.com/a", "url": "https://example.com/a", "rel": "../articles/x", "title": "A [draft] | v2", "expected": "[[../articles/x|A draft  v2]]" },
    { "name": "every occurrence changes", "text": "[a](https://example.com/a) and [b](https://example.com/a)", "url": "https://example.com/a", "rel": "x", "title": "T", "expected": "[[x|a]] and [[x|b]]" },
    { "name": "unswappable stays", "text": "[a|b](https://example.com/a)", "url": "https://example.com/a", "rel": "x", "title": "T", "expected": "[a|b](https://example.com/a)" }
  ]
