{
  "scan": [
    { "name": "1 inline link", "text": "See [The paper](https://example.com/a) now.", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "The paper" }] },
    { "name": "1 inline link with a title", "text": "[a](https://example.com/a \"A title\")", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "a" }] },
    { "name": "1 autolink", "text": "<https://example.com/a>", "links": [{ "url": "https://example.com/a", "form": "autolink" }] },
    { "name": "1 bare URL", "text": "Read https://example.com/a?x=1&y=2#frag today", "links": [{ "url": "https://example.com/a?x=1&y=2#frag", "form": "bare" }] },
    { "name": "1 scheme is case-insensitive and spelling is kept", "text": "HTTPS://Example.com/A and [b](HTTP://example.com/B)", "links": [{ "url": "HTTPS://Example.com/A", "form": "bare" }, { "url": "HTTP://example.com/B", "form": "inline", "label": "b" }] },
    { "name": "1 document order", "text": "[a](https://example.com/a) then https://example.com/b then <https://example.com/c>", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "a" }, { "url": "https://example.com/b", "form": "bare" }, { "url": "https://example.com/c", "form": "autolink" }] },
    { "name": "1 other schemes and relative links are not links", "text": "[m](mailto:x@example.com) [f](ftp://example.com/a) [r](relative/path.md) [h](#heading)", "links": [] },
    { "name": "2 image", "text": "![alt](https://example.com/a.png)", "links": [] },
    { "name": "2 link around an image", "text": "[![alt](https://example.com/i.png)](https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "![alt](https://example.com/i.png)", "swappable": false }] },
    { "name": "3 frontmatter", "text": "---\nsource: https://example.com/a\n---\nhttps://example.com/b", "links": [{ "url": "https://example.com/b", "form": "bare" }] },
    { "name": "3 fenced code", "text": "```\nhttps://example.com/a\n```\nhttps://example.com/b", "links": [{ "url": "https://example.com/b", "form": "bare" }] },
    { "name": "3 tilde fence and a longer closer", "text": "~~~\nhttps://example.com/a\n~~~~\nhttps://example.com/b", "links": [{ "url": "https://example.com/b", "form": "bare" }] },
    { "name": "3 a shorter fence does not close", "text": "````\n```\nhttps://example.com/a\n````\nhttps://example.com/b", "links": [{ "url": "https://example.com/b", "form": "bare" }] },
    { "name": "3 unclosed fence runs to the end", "text": "```\nhttps://example.com/a\n\nhttps://example.com/b", "links": [] },
    { "name": "3 inline code", "text": "`https://example.com/a` and ``x ` https://example.com/b`` and https://example.com/c", "links": [{ "url": "https://example.com/c", "form": "bare" }] },
    { "name": "3 stray backtick", "text": "a ` b https://example.com/a", "links": [{ "url": "https://example.com/a", "form": "bare" }] },
    { "name": "3 percent comments", "text": "%%https://example.com/a\nhttps://example.com/b%% https://example.com/c", "links": [{ "url": "https://example.com/c", "form": "bare" }] },
    { "name": "3 criticmarkup", "text": "{++https://example.com/a++} {--https://example.com/b--} {~~https://example.com/c~>https://example.com/d~~} {==https://example.com/e==} {>>https://example.com/f<<} https://example.com/g", "links": [{ "url": "https://example.com/g", "form": "bare" }] },
    { "name": "3 html comment and tags", "text": "<!-- https://example.com/a --> <a href=\"https://example.com/b\">x</a> https://example.com/c", "links": [{ "url": "https://example.com/c", "form": "bare" }] },
    { "name": "3 wikilinks", "text": "[[https://example.com/a]] [[note|https://example.com/b]] https://example.com/c", "links": [{ "url": "https://example.com/c", "form": "bare" }] },
    { "name": "3 reference definition", "text": "[1]: https://example.com/a\nhttps://example.com/b", "links": [{ "url": "https://example.com/b", "form": "bare" }] },
    { "name": "3 backslash-escaped bracket is not a link", "text": "\\[a](https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "bare", "swappable": false }] },
    { "name": "4 balanced parentheses in an inline URL", "text": "[w](https://en.wikipedia.org/wiki/Foo_(bar))", "links": [{ "url": "https://en.wikipedia.org/wiki/Foo_(bar)", "form": "inline", "label": "w" }] },
    { "name": "5 trailing punctuation is trimmed", "text": "Read https://example.com/a. Then **https://example.com/b** and https://example.com/c, ok", "links": [{ "url": "https://example.com/a", "form": "bare" }, { "url": "https://example.com/b", "form": "bare" }, { "url": "https://example.com/c", "form": "bare" }] },
    { "name": "5 an unbalanced closing parenthesis is trimmed", "text": "(see https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "bare" }] },
    { "name": "5 a balanced closing parenthesis stays", "text": "https://en.wikipedia.org/wiki/Foo_(bar) ok", "links": [{ "url": "https://en.wikipedia.org/wiki/Foo_(bar)", "form": "bare" }] },
    { "name": "5 a bare URL stops at a pipe", "text": "a|https://example.com/a|b", "links": [{ "url": "https://example.com/a", "form": "bare" }] },
    { "name": "6 a label does not span lines", "text": "[a\nb](https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "bare", "swappable": false }] },
    { "name": "7 brackets in a label", "text": "[Smith [2020]](https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "Smith [2020]", "swappable": false }] },
    { "name": "7 pipe in a label", "text": "[a|b](https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "a|b", "swappable": false }] },
    { "name": "7 emphasis in a label", "text": "[**a**](https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "**a**", "swappable": false }] },
    { "name": "7 code in a label", "text": "[`a`](https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "`a`", "swappable": false }] },
    { "name": "7 empty label", "text": "[](https://example.com/a)", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "" }] },
    {"name": "3 indented code", "text": "a\n\n    [x](https://example.com/a)\n    https://example.com/b\n\n    https://example.com/c\nhttps://example.com/d", "links": [{"url": "https://example.com/d", "form": "bare"}]},
    {"name": "3 indented code with a tab", "text": "a\n\n\thttps://example.com/a\n", "links": []},
    {"name": "3 an indented line inside a paragraph is not code", "text": "a\n    https://example.com/a", "links": [{"url": "https://example.com/a", "form": "bare"}]},
    {"name": "3 a nested list item is not code", "text": "- a\n\n    - [x](https://example.com/a)", "links": [{"url": "https://example.com/a", "form": "inline", "label": "x"}]},
    {"name": "3 a tag across lines", "text": "<iframe\n  src=\"https://example.com/a\"\n></iframe> https://example.com/b", "links": [{"url": "https://example.com/b", "form": "bare"}]},
    {"name": "3 pre element", "text": "<pre>\n[x](https://example.com/a)\n</pre>\nhttps://example.com/b", "links": [{"url": "https://example.com/b", "form": "bare"}]},
    {"name": "3 code element", "text": "<CODE class=\"x\">https://example.com/a</code> https://example.com/b", "links": [{"url": "https://example.com/b", "form": "bare"}]},
    {"name": "3 unclosed pre runs to the end", "text": "<pre>\nhttps://example.com/a", "links": []},
    {"name": "5 typographic quotes", "text": "“https://example.com/a” next", "links": [{"url": "https://example.com/a", "form": "bare"}]},
    {"name": "5 full-width punctuation", "text": "https://example.com/a。https://example.com/b，then", "links": [{"url": "https://example.com/a", "form": "bare"}, {"url": "https://example.com/b", "form": "bare"}]},
    {"name": "5 stops at a brace", "text": "https://example.com/a{++x++} b", "links": [{"url": "https://example.com/a", "form": "bare"}]},
    {"name": "6 a destination in angle brackets, after a label over two lines", "text": "[a\nb](<https://example.com/a>)", "links": [{"url": "https://example.com/a", "form": "autolink", "swappable": false}]},
    {"name": "6 a spaced destination, after a label over two lines", "text": "[a\nb]( https://example.com/a )", "links": [{"url": "https://example.com/a", "form": "bare", "swappable": false}]},
    {"name": "8 a table in a blockquote", "text": "> | [x](https://example.com/a) | b |", "links": [{"url": "https://example.com/a", "form": "inline", "label": "x", "in_table": true}]},
    { "name": "8 table rows", "text": "| a | b |\n|---|---|\n| [x](https://example.com/a) | https://example.com/b |\nnot a row https://example.com/c", "links": [{ "url": "https://example.com/a", "form": "inline", "label": "x", "in_table": true }, { "url": "https://example.com/b", "form": "bare", "in_table": true }, { "url": "https://example.com/c", "form": "bare" }] }
